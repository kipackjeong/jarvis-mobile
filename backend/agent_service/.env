# Agent Service Environment Example
# Copy to .env and adjust values as needed

# Provider selection: mock | openai | azure
# Aliases: azure_foundry, azure-openai, azure-ai -> map to 'azure'
PROVIDER=azure
DEBUG=false
AGENT_NAME=JarvisAgent
AGENT_INSTRUCTIONS=You are a helpful assistant.
AGENT_PROMPTY=jarvis

# OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure provider (Azure AI Foundry / Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://kipackjeong-jarvis-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini-global
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Use Azure CLI credential if API key not set (requires `az login`)
AZURE_OPENAI_USE_CLI_CREDENTIAL=false
AZURE_OPENAI_API_KEY=1klPLVb8CN9XWrwP9pBQQIDHeOszFmNkfIpuPnnp2uUJG7T52WXtJQQJ99BJACHYHv6XJ3w3AAAAACOGubGM
